# Copy to .env for local runs. Values tagged @ssm= come from AWS SSM on the server (ADR-0014).

# @desc Postgres password for the ai database. Generated on the server; never leaves it @required @secret @used=compose
POSTGRES_PASSWORD=

# @desc Ed25519 private key (PEM, one line with \n escapes) that signs each tool call to an app. Made with backend/scripts/signing-key.mjs; apps hold the public key at /sirloinbh/shared/ai-tools-public-key @required @secret @used=compose @ssm=/sirloinbh/shared-ai/tools-signing-key
AI_TOOLS_SIGNING_KEY=

# @desc Claude API key of shared-ai only (ADR-0019); study-log keeps the shared key. Without it Claude calls are off @secret @used=compose @ssm=/sirloinbh/shared-ai/anthropic-api-key
ANTHROPIC_API_KEY=

# @desc Monthly token limit (input + output + cache read + cache write, UTC calendar month) checked before every Claude call @used=compose
AI_MONTHLY_TOKEN_LIMIT=5000000

# @desc Claude model for the AI shell @used=compose
CLAUDE_MODEL=claude-opus-5-5

# @desc Owner ID put in every call token and the apps' audit rows (the shared sign-in user ID). Default: owner @used=compose
AI_OWNER_ID=

# @desc Seconds between tool list refreshes @used=compose
AI_TOOLS_REFRESH_SECONDS=180

# @desc Local runs only: apps to read tools from, name=url,name=url. Empty: every registry app at http://<app>-api:<api port> @used=compose
AI_TOOL_APPS=
