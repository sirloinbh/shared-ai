# Managed file. Edit it in sirloinbh/project-standards templates/deploy/deploy/
[Unit]
Description=shared-ai daily server report for healthchecks.io
After=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/shared-ai
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/shared-ai/deploy/report.sh /tmp/shared-ai-report.sh && exec /bin/bash /tmp/shared-ai-report.sh'
TimeoutStartSec=5min
